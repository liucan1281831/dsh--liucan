{
  "name": "dsh-plugin-fish-pet",
  "version": "0.6.0",
  "description": "桌面小鱼宠物：显示 DeepSeek 余额、峰谷时段与天气；支持摸摸互动、外观/音效自定义、语音合成与本地声音克隆、语种切换、Live2D 与动态形象。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "license": "MIT"
}
