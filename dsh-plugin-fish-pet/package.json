{
  "name": "dsh-plugin-fish-pet",
  "version": "0.2.0",
  "description": "桌面小鱼宠物：悬浮在 DSH 界面右下角，实时显示 DeepSeek 余额，可拖动、可隐藏，点击可刷新。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "license": "MIT"
}
